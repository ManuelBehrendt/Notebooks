# Ignore everything in the root except markdown and assets
# (Uncomment if you want to only track markdown files)
# /*
# !markdown/
# !assets/
# !.gitignore
# !README.md

# Re-execution staging dir (duplicates the tracked top-level notebooks)
executed/
**/executed/

# =============================================================================
# Publishable content — added 2026-07-31
#
# These notebooks are the SOURCE OF TRUTH for the Mera.jl documentation: each is
# converted to Markdown and becomes a page under Mera.jl/docs/src, and publishing
# them is what makes the "Run it yourself" link on 44 tutorial pages resolve.
#
# So this folder should hold notebooks and the assets a notebook needs — nothing
# else. Unfiltered it is 7.3 GB, of which ~7 GB is simulation data, VTK exports,
# and rendered copies of files that already live in the Mera.jl repo.
#
# Rule of thumb: if a file can be REGENERATED — by running a notebook, by
# nbconvert, or by re-exporting from a simulation — it does not belong here.
# =============================================================================

# ── nbconvert output ─────────────────────────────────────────────────────────
# The rendered pages and their extracted figures live in Mera.jl/docs/src.
# A second copy here is one more thing to update and one more to forget.
/*.md
!/README.md
*.html
**/*.html
*_files/
**/*_files/
markdown/

# ── retired notebooks ────────────────────────────────────────────────────────
# Superseded by current pages; kept on disk for reference, not for readers.
_superseded/


# ── ParaView export products (5.2 GB) ────────────────────────────────────────
# The VTK notebooks WRITE these. Ship the notebooks (112 KB), not their output.
paraview/output*/
*.vtu
*.vtm
*.vti
*.pvd

# ── example datasets (1.7 GB) ────────────────────────────────────────────────
# simulation_hydro.dat and .csv are 463 MB EACH — past GitHub's 100 MB per-file
# limit, so a push would be rejected outright. The notebooks regenerate them.
examples/*.dat
examples/*.csv
examples/*.jld
examples/*.jld2
examples/*.jls
examples/*.jls.gz

# ── raw simulation data, wherever it turns up ────────────────────────────────
*.hdf5
*.h5
output_*/

# JupyterLab writes a shadow copy of each open notebook here. It is an editor artifact,
# never a source file.
.virtual_documents/
**/.virtual_documents/

# The gallery is the exception to the rules above. A recipe is only reproducible if it ships
# the environment it ran in, and the thumbnail helper is part of the folder rather than a
# stray script. Without these three the gallery reaches GitHub as notebooks with no way to
# rerun them.
!gallery/make_thumb.jl
!gallery/**/Project.toml
!gallery/**/Manifest.toml

# Notebooks and folders kept on this machine only are listed in .git/info/exclude.
